<svg xmlns="http://www.w3.org/2000/svg" width="400" height="300" viewBox="0 0 400 300">
  <defs>
    <linearGradient id="techGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#667eea;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#764ba2;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#techGrad)"/>
  <rect x="50" y="50" width="80" height="60" rx="5" fill="rgba(255,255,255,0.2)"/>
  <rect x="150" y="80" width="100" height="80" rx="5" fill="rgba(255,255,255,0.15)"/>
  <rect x="270" y="60" width="90" height="70" rx="5" fill="rgba(255,255,255,0.25)"/>
  <text x="200" y="200" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="22" font-weight="bold">TechStart</text>

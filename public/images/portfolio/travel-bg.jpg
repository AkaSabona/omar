<svg xmlns="http://www.w3.org/2000/svg" width="400" height="300" viewBox="0 0 400 300">
  <defs>
    <linearGradient id="travelGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#fa709a;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#fee140;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#travelGrad)"/>
  <circle cx="80" cy="80" r="25" fill="rgba(255,255,255,0.4)"/>
  <polygon points="150,60 180,40 210,60 210,100 150,100" fill="rgba(255,255,255,0.3)"/>
  <ellipse cx="300" cy="120" rx="50" ry="30" fill="rgba(255,255,255,0.25)"/>
  <path d="M 100 200 Q 200 150 300 200" stroke="rgba(255,255,255,0.5)" stroke-width="3" fill="none"/>
  <text x="200" y="240" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="18" font-weight="bold">Wanderlust Tours</text>
</svg>